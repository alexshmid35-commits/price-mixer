[Unit]
Description=Price Mixer durable background worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=price-mixer
Group=price-mixer
WorkingDirectory=/opt/price-mixer/current
EnvironmentFile=/etc/price-mixer/price-mixer.env
ExecStartPre=/opt/price-mixer/current/.venv/bin/python deploy/check_production.py
ExecStart=/opt/price-mixer/current/.venv/bin/python -m price_mixer.workers.durable_worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/price-mixer/current
ReadWritePaths=/var/lib/price-mixer/state
ReadWritePaths=/var/lib/price-mixer/data
ReadWritePaths=/var/lib/price-mixer/uploads
ReadWritePaths=/var/cache/price-mixer
ReadWritePaths=/var/log/price-mixer

StandardOutput=journal
StandardError=journal
SyslogIdentifier=price-mixer-worker

[Install]
WantedBy=multi-user.target
