PRICE_MIXER_ENV=production
PRICE_MIXER_BIND=127.0.0.1:5001
PRICE_MIXER_WORKERS=1
PRICE_MIXER_THREADS=4
PRICE_MIXER_REQUEST_TIMEOUT=900
PRICE_MIXER_GRACEFUL_TIMEOUT=120
PRICE_MIXER_TRUST_PROXY=1
PRICE_MIXER_FORWARDED_ALLOW_IPS=127.0.0.1
PRICE_MIXER_LOG_LEVEL=info
PRICE_MIXER_LOG_FORMAT=json
PRICE_MIXER_BACKUP_DIR=/srv/price-mixer-backups
PRICE_MIXER_STATE_DIR=/var/lib/price-mixer/state
PRICE_MIXER_DATA_DIR=/var/lib/price-mixer/data
PRICE_MIXER_CACHE_DIR=/var/cache/price-mixer
PRICE_MIXER_UPLOAD_DIR=/var/lib/price-mixer/uploads
PRICE_MIXER_LOG_DIR=/var/log/price-mixer
PRICE_MIXER_JOB_MODE=external
PRICE_MIXER_JOB_DB=/var/lib/price-mixer/data/jobs.db

ADMIN_USERNAME=price-mixer-admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
FLASK_SECRET_KEY=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET

GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=/etc/price-mixer/google-service-account.json
OPENAI_API_KEY=
ONLINER_B2B_CLIENT_ID=
ONLINER_B2B_CLIENT_SECRET=
NTECH_USERNAME=
NTECH_PASSWORD=
IVEN_FILE_URL=
TRADEX_FILE_URL=
