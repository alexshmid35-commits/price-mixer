    "keep_last_sessions": 20,
    "keep_days": 7,
    "keep_api_fetch_hours": 24
  },
  "no_id_search": {
    "max_candidates": 80,
    "max_queries": 4,
    "prefer_paren_model": true,
    "prefer_article_tokens": true,
    "include_brand_token": true,
    "require_category_hint": true,
    "category_rules_text": "{\n  \"Процессор\": {\n    \"query_hint\": \"cpu processor\",\n    \"must_contain\": [\n      \"ryzen\",\n      \"intel\",\n      \"xeon\"\n    ],\n    \"ignore_words\": [\n      \"cooler\"\n    ]\n  },\n  \"Видеокарта\": {\n    \"query_hint\": \"videocard gpu\",\n    \"must_contain\": [\n      \"rtx\",\n      \"gtx\",\n      \"radeon\"\n    ],\n    \"ignore_words\": [\n      \"holder\"\n    ]\n  },\n  \"Оперативная память\": {\n    \"query_hint\": \"dram ddr memory\",\n    \"must_contain\": [\n      \"ddr\",\n      \"dimm\",\n      \"sodimm\"\n    ],\n    \"ignore_words\": [\n      \"ssd\"\n    ]\n  },\n  \"SSD\": {\n    \"query_hint\": \"ssd nvme\",\n    \"must_contain\": [\n      \"ssd\",\n      \"nvme\",\n      \"m.2\"\n    ],\n    \"ignore_words\": [\n      \"dram\"\n    ]\n  },\n  \"Жесткий диск\": {\n    \"query_hint\": \"hdd hard drive\",\n    \"must_contain\": [\n      \"hdd\",\n      \"sata\",\n      \"7200\"\n    ],\n    \"ignore_words\": [\n      \"ssd\"\n    ]\n  }\n}"
  },
  "verify_id": {
    "match_threshold": 0.74,
    "trust_manual_confirmed": true,
    "force_refresh_api": true,
    "api_no_name_status": "review",
    "require_article_or_model_priority": false
  }
