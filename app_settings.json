      },
      {
        "pattern": "tradex",
        "supplier": "Tradex"
      },
      {
        "pattern": "1030z",
        "supplier": "IVEN"
      },
      {
        "pattern": "1030",
        "supplier": "IVEN"
      },
      {
        "pattern": "1374",
        "supplier": "IVEN"
      },
      {
        "pattern": "price_bn",
        "supplier": "N-Tech"
      },
      {
        "pattern": "ntech",
        "supplier": "N-Tech"
      },
      {
        "pattern": "iven",
